{
  "PKGBUILD Template": {
    "prefix": "pkgbuild",
    "body": [
      "# Maintainer: Your Name <your@email.com>",
      "pkgname=${1:pkgname}",
      "pkgver=${2:1.0}",
      "pkgrel=${3:1}",
      "pkgdesc=\"${4:Package description}\"",
      "arch=('${5:any}')",
      "url=\"${6:https://github.com/your/repo}\"",
      "license=('${7:GPL-3.0-or-later}')",
      "${8:depends=('')}",
      "${9:makedepends=('')}",
      "source=(${10:source})",
      "sha256sums=('${11:SKIP}')",
      "",
      "build() {",
      "  cd \"$srcdir/${1:pkgname}\"",
      "  ${0}",
      "}",
      "",
      "package() {",
      "  cd \"$srcdir/${1:pkgname}\"",
      "  ${0}",
      "}"
    ],
    "description": "Basic PKGBUILD template"
  },
  "PKGBUILD Git Source": {
    "prefix": "pkgbuild-git",
    "body": [
      "# Maintainer: Your Name <your@email.com>",
      "pkgname=${1:pkgname}",
      "pkgver=${2:1.0}",
      "pkgrel=${3:1}",
      "pkgdesc=\"${4:Package description}\"",
      "arch=('${5:x86_64}')",
      "url=\"${6:https://github.com/your/repo}\"",
      "license=('${7:GPL-3.0-or-later}')",
      "depends=(${8:})",
      "makedepends=(${9:git cmake extra-cmake-modules})",
      "source=(\"git+https://github.com/${10:owner/repo}.git#tag=v${pkgver}\")",
      "sha256sums=('SKIP')",
      "",
      "build() {",
      "  cd \"$srcdir/${1:pkgname}\"",
      "  mkdir -p build && cd build",
      "  cmake .. \\",
      "    -DCMAKE_INSTALL_PREFIX=/usr \\",
      "    -DCMAKE_BUILD_TYPE=Release \\",
      "    ${0}",
      "  make",
      "}",
      "",
      "package() {",
      "  cd \"$srcdir/${1:pkgname}/build\"",
      "  make DESTDIR=\"$pkgdir\" install",
      "}"
    ],
    "description": "PKGBUILD with git source and cmake build"
  },
  "PKGBUILD Simple": {
    "prefix": "pkgbuild-simple",
    "body": [
      "# Maintainer: Your Name <your@email.com>",
      "pkgname=${1:pkgname}",
      "pkgver=${2:1.0}",
      "pkgrel=${3:1}",
      "pkgdesc=\"${4:Package description}\"",
      "arch=('${5:any}')",
      "url=\"${6:https://github.com/your/repo}\"",
      "license=('${7:GPL-3.0-or-later}')",
      "source=(${8:source})",
      "sha256sums=('${9:SKIP}')",
      "",
      "package() {",
      "  install -dm755 \"$pkgdir/${10:path}\"",
      "  install -m644 ${1:pkgname}.conf \"$pkgdir/${10:path}/${1:pkgname}.conf\"",
      "}"
    ],
    "description": "Simple PKGBUILD for config files"
  }
}