# Maintainer: Nexus Linux
# Fork of cachyos-packageinstaller (GPL-3.0-or-later). Simple package
# installer for Nexus Linux; source tracks the upstream CachyOS repo (signed
# tag).

pkgname=nexus-packageinstaller
pkgver=1.6.2
pkgrel=1
pkgdesc="Simple Software Application Package Installer for Nexus Linux which helps setting up & installing applications"
arch=(aarch64 x86_64)
url="https://github.com/nexuslinux-os/NexusLinux"
license=(GPL-3.0-or-later)
depends=('qt6-base' 'polkit')
makedepends=('cmake' 'ninja' 'git' 'polkit-qt6' 'qt6-tools' 'cargo' 'lld' 'clang' 'llvm')
conflicts=('cachyos-packageinstaller')
provides=('cachyos-packageinstaller')
source=("packageinstaller::git+https://github.com/cachyos/packageinstaller.git#tag=v${pkgver}?signed")
sha256sums=('8b63b69702f5fe1c38d746e61ad232d2deeba8c1eadfacdf53735bf9ff518edc')
validpgpkeys=(
  'B1B70BB1CD56047DEF31DE2EB62C3D10C54D5DA9'  # Vladislav Nepogodin <nepogodin.vlad@gmail.com>
)

prepare() {
  cd ${srcdir}/packageinstaller

  # Ship KDE Discover in the "Other" category of the pkg list.
  sed -i 's#^    - variety$#    - variety\n    - plasma-discover#' pkglist.yaml
}

build() {
  cd ${srcdir}/packageinstaller

  # we are building with llvm stack here, due to rust
  export AR=llvm-ar
  export CC=clang
  export CXX=clang++
  export NM=llvm-nm
  export RANLIB=llvm-ranlib

  export RUSTFLAGS="-Cembed-bitcode -C opt-level=3 -Ccodegen-units=1 -Clinker=clang -C link-arg=-flto -Clink-arg=-fuse-ld=/usr/bin/ld.lld"

  cmake -S . -Bbuild \
        -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib
  cmake --build build --parallel
}

package() {
  cd ${srcdir}/packageinstaller

  # we are building with llvm stack here, due to rust
  export AR=llvm-ar
  export CC=clang
  export CXX=clang++
  export NM=llvm-nm
  export RANLIB=llvm-ranlib

  export RUSTFLAGS="-Cembed-bitcode -C opt-level=3 -Ccodegen-units=1 -Clinker=clang -C link-arg=-flto -Clink-arg=-fuse-ld=/usr/bin/ld.lld"

  DESTDIR="${pkgdir}" cmake --build build --target install
}
