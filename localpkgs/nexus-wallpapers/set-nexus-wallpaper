#!/bin/bash
# Apply the Nexus default wallpaper for window-manager sessions that do not
# manage their own background. Runs from the nexus-wallpaper.desktop XDG
# autostart entry. Full desktop environments (KDE, GNOME, Xfce, ...) manage
# the background themselves and are skipped.
set -e

WALLPAPER=/usr/share/backgrounds/nexus/wallpaper.png
[ -f "$WALLPAPER" ] || exit 0

case "${XDG_CURRENT_DESKTOP:-$DESKTOP_SESSION}" in
    KDE*|GNOME*|Xfce*|LXQt*|LXDE*|MATE*|Cinnamon*|Budgie*|COSMIC*|cosmic*)
        exit 0
        ;;
esac

case "$XDG_SESSION_TYPE" in
    wayland)
        if command -v swaybg >/dev/null 2>&1; then
            exec swaybg -i "$WALLPAPER" -m fill
        fi
        ;;
    x11)
        if command -v feh >/dev/null 2>&1; then
            feh --no-fehbg --bg-fill "$WALLPAPER" >/dev/null 2>&1
        fi
        ;;
esac

exit 0
