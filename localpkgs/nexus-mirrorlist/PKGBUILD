# Maintainer: Nexus Linux
# Based on the official CachyOS cachyos-mirrorlist PKGBUILD (GPL-3.0-or-later).
#
# IMPORTANT: the mirror files are installed at the /etc/pacman.d/cachyos-*
# paths because the installed system's pacman.conf sections ([cachyos],
# [cachyos-v3], [cachyos-v4], ...) must match the database filenames served by
# the mirrors. Until Nexus hosts its own repository (nexus.db), the repo
# section names stay "cachyos"; only the package names and file contents are
# Nexus-branded.

pkgbase=nexus-mirrorlist
pkgname=('nexus-mirrorlist' 'nexus-v3-mirrorlist' 'nexus-v4-mirrorlist')
pkgver=1
pkgrel=1
pkgdesc="Nexus repository mirrorlist"
url='https://nexuslinux.org'
arch=('any')
license=(GPL-3.0-or-later)
source=(nexus-mirrorlist)
sha512sums=('SKIP')

package_nexus-mirrorlist() {
    backup=("etc/pacman.d/cachyos-mirrorlist")  # to keep possibly ranked mirrorlist
    conflicts=('cachyos-mirrorlist')
    provides=('cachyos-mirrorlist')
    install -Dm644 "$srcdir/$pkgbase" "$pkgdir/etc/pacman.d/cachyos-mirrorlist"
}

package_nexus-v3-mirrorlist() {
    backup=("etc/pacman.d/cachyos-v3-mirrorlist")  # to keep possibly ranked mirrorlist
    conflicts=('cachyos-v3-mirrorlist')
    provides=('cachyos-v3-mirrorlist')
    install -Dm644 "$srcdir/$pkgbase" "$pkgdir/etc/pacman.d/cachyos-v3-mirrorlist"
    sed -i 's|/$arch/|/$arch_v3/|g' "$pkgdir/etc/pacman.d/cachyos-v3-mirrorlist"
}

package_nexus-v4-mirrorlist() {
    backup=("etc/pacman.d/cachyos-v4-mirrorlist")  # to keep possibly ranked mirrorlist
    conflicts=('cachyos-v4-mirrorlist')
    provides=('cachyos-v4-mirrorlist')
    install -Dm644 "$srcdir/$pkgbase" "$pkgdir/etc/pacman.d/cachyos-v4-mirrorlist"
    sed -i 's|/$arch/|/$arch_v4/|g' "$pkgdir/etc/pacman.d/cachyos-v4-mirrorlist"
}
