# Maintainer: Nexus Linux
# Fork of cachyos-settings (GPL-1.0-only). Ships the system tuning defaults
# (zram, ananicy, power profiles, ...) with Nexus package naming. Content is
# currently identical to upstream; review the etc/ and usr/ trees of
# CachyOS-Settings for brand-visible strings when Nexus diverges.

_gitname=CachyOS-Settings
pkgname=nexus-settings
pkgver=1.3.5
pkgrel=2
epoch=1
arch=('any')
license=(GPL-1.0-only)
makedepends=('coreutils' 'git')
pkgdesc='Nexus - Settings'
url="https://github.com/CachyOS/$_gitname"
source=("git+$url.git?signed#tag=$pkgver")
install="$pkgname.install"
sha256sums=('7fb5ed29939691b3263183c504e9e638a6ee2a03de93a6e525b74cfb8e4f8a8f')
validpgpkeys=(
  E8B9AA39F054E30E8290D492C3C4820857F654FE  # Peter Jung <admin@ptr1337.dev>
  B1B70BB1CD56047DEF31DE2EB62C3D10C54D5DA9  # Vladislav Nepogodin <nepogodin.vlad@gmail.com>
)
depends=(
  zram-generator
  ananicy-cpp
  cachyos-ananicy-rules
  inxi
  "systemd>=256"
  iw
  wireless-regdb
)
optdepends=('libluv: for topmem'
            'lua-luv: for topmem'
            'power-profiles-daemon: For game-performance')
conflicts=('cachyos-settings')
provides=('cachyos-settings' 'ntsync-common')

prepare() {
  cd $_gitname
}
package() {
  install -d "$pkgdir/etc"
  cp -rf "${srcdir}/${_gitname}/etc" "$pkgdir"
  install -d "$pkgdir/usr"
  cp -rf "${srcdir}/${_gitname}/usr" "$pkgdir"
}
