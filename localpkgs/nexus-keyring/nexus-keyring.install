post_install() {
    # Add the Nexus master key and mark it as trusted, so pacman verifies the
    # signature of nexus-* packages and the nexus repository database.
    if [ -x /usr/bin/pacman-key ]; then
        pacman-key --add /usr/share/pacman/keyrings/nexus.gpg 2>/dev/null || true
        pacman-key --lsign-key 7E08C6020E20F32C9F95833C803D28F88FFED82B 2>/dev/null || true
    fi
}

post_upgrade() {
    post_install
}
