post_install() {
    # Initialize pacman keyring if needed
    if [[ ! -d /etc/pacman.d/gnupg ]]; then
        pacman-key --init
    fi
    
    # Add and sign Nexus key
    if [[ -f /usr/share/pacman/keyrings/nexus.gpg ]]; then
        pacman-key --add /usr/share/pacman/keyrings/nexus.gpg
        # Note: You must manually lsign the key after verifying the fingerprint:
        # pacman-key --lsign-key "Nexus Linux Packaging"
        # Or by fingerprint: pacman-key --lsign-key FINGERPRINT
    fi
    
    # Import trusted keys
    if [[ -f /usr/share/pacman/keyrings/nexus-trusted ]]; then
        while read -r line; do
            [[ -n "$line" && ! "$line" =~ ^# ]] && pacman-key --finger "$line" 2>/dev/null || true
        done < /usr/share/pacman/keyrings/nexus-trusted
    fi
    
    # Update trust database
    pacman-key --populate archlinux
}

post_upgrade() {
    post_install
}

post_remove() {
    # Don't remove key on package removal to avoid breaking installed systems
    true
}