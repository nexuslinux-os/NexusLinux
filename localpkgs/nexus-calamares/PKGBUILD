Font=Noto Sans,10,-1,5,50,0,0,0,0,0,0
Fixed=Noto Sans Mono,10,-1,5,50,0,0,0,0,0,0
MenuFont=Noto Sans,10,-1,5,50,0,0,0,0,0,0
TaskbarFont=Noto Sans,10,-1,5,50,0,0,0,0,0,0
WindowTitleFont=Noto Sans,10,-1,5,50,0,0,0,0,0,0
SmallestReadableFont=Noto Sans,8,-1,5,50,0,0,0,0,0,0
SingleClick=false
ShowToolTips=true
