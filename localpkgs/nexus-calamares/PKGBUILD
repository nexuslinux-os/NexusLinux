# Maintainer: Nexus Linux
# Fork of cachyos-calamares-next (GPL-3.0-or-later). Builds the Calamares
# installer from the CachyOS branch and applies Nexus branding to the shipped
# settings before install. The runtime branding/overrides remain handled by
# /usr/local/bin/calamares-{online,offline}.sh.

pkgname=nexus-calamares
pkgver=3.4.2
pkgrel=7
pkgdesc='Distribution-independent installer framework (Nexus fork)'
arch=('x86_64')
license=(GPL-3.0-or-later)
url="https://github.com/CachyOS/cachyos-calamares"
conflicts=('calamares' 'cachyos-calamares-next')
provides=('calamares' 'cachyos-calamares-next')
depends=(
  boost-libs
  ckbcomp
  cryptsetup
  dmidecode
  gptfdisk
  hwinfo
  kconfig
  kcoreaddons
  kcrash
  ki18n
  kparts
  kpmcore
  kservice
  kwidgetsaddons
  libpwquality
  mkinitcpio-openswap
  networkmanager
  polkit-qt6
  python
  qt6-declarative
  qt6-svg
  rsync
  solid
  squashfs-tools
  upower
  yaml-cpp
  qt6-imageformats
  python-toml
)
makedepends=(
  boost
  cmake
  doxygen
  extra-cmake-modules
  git
  ninja
  python-jsonschema
  python-pyaml
  python-unidecode
  qt6-tools
)
sha256sums=('SKIP')
source=(calamares::"git+${url}.git#branch=cachyos-dev")
options=('!emptydirs')

prepare() {
    cd ${srcdir}/calamares
    # change version
    _ver="$pkgver"
    printf 'Version: %s-%s\n' "${_ver}" "${pkgrel}"
    sed -i -e "s|\${CALAMARES_VERSION_MAJOR}.\${CALAMARES_VERSION_MINOR}.\${CALAMARES_VERSION_PATCH}|${_ver}-${pkgrel}|g" CMakeLists.txt
    sed -i -e "s|CALAMARES_VERSION_RC 1|CALAMARES_VERSION_RC 0|g" CMakeLists.txt
    # Apply Nexus branding to the shipped settings files.
    sed -i 's|^branding: cachyos$|branding: nexus|' settings_online.conf settings_offline.conf settings.conf
    # The Nexus fork swaps cachyos-* packages for nexus-* equivalents that are
    # baked into the live squashfs (packages*.x86_64 swap). The upstream
    # installer scripts still try to (re)install the old cachyos-* packages at
    # install time, which now CONFLICT with the baked-in nexus-* ones and also
    # depend on the [nexus] repo that is only published to GitHub Releases
    # later. Drop those package installs and run the forked binaries directly.
    # Calamares captures stdout only (stderr is dropped), so mirror stderr into
    # stdout like create-pacman-keyring does.
    sed -i '1a exec 2>&1' src/scripts/update-mirrorlist
    sed -i \
        -e 's/sudo pacman -Sy --noconfirm --needed cachyos-rate-mirrors rate-mirrors/sudo pacman -Sy --noconfirm --needed rate-mirrors/' \
        -e 's/sudo cachyos-rate-mirrors/sudo nexus-rate-mirrors/' \
        src/scripts/update-mirrorlist
    sed -i '/cachyos-keyring/d' src/scripts/create-pacman-keyring
}

build() {
    cd ${srcdir}/calamares

    export CXXFLAGS+=" -fPIC"

    cmake -S . -Bbuild \
        -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DWITH_APPSTREAM=OFF \
        -DWITH_PYBIND11=OFF \
        -DWITH_QT6=ON \
        -DSKIP_MODULES="dracut dracutlukscfg \
        dummycpp dummyprocess dummypython dummypythonqt \
        finishedq keyboardq license localeq notesqml oemid \
        openrcdmcryptcfg packagechooserq fsresizer \
        rawfs mkinitfs contextualprocess interactiveterminal \
        plasmalnf services-openrc \
        summaryq tracking usersq webview welcomeq"

    cmake --build build
}

package() {
    cd ${srcdir}/calamares/build
    DESTDIR="${pkgdir}" cmake --build . --target install

    cp ${srcdir}/calamares/settings_offline.conf "$pkgdir/usr/share/calamares/settings_offline.conf"
    cp ${srcdir}/calamares/settings_online.conf "$pkgdir/usr/share/calamares/settings_online.conf"
    cp ${srcdir}/calamares/settings_online.conf "$pkgdir/usr/share/calamares/settings.conf"
    local _destdir=etc/calamares
    install -dm755 $pkgdir/$_destdir
    install -dm755 $pkgdir/$_destdir/modules
    cp -rf ${srcdir}/calamares/src/modules/*/*.conf "$pkgdir/etc/calamares/modules"
    cp -rf ${srcdir}/calamares/src/scripts "$pkgdir/etc/calamares"
    cp -rf ${srcdir}/calamares/src/images "$pkgdir/etc/calamares"

    cp ${srcdir}/calamares/src/modules/netinstall/netinstall.yaml "$pkgdir/etc/calamares/modules/netinstall.yaml"

    rm -rf "$pkgdir/usr/share/applications"
}
