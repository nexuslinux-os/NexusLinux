EOF

    # Look-and-feel theme "Nexus" for lookandfeeltool
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents"
    install -m644 /dev/stdin "$pkgdir/usr/share/plasma/look-and-feel/nexus/metadata.json" <<'EOF'
{
    "Name": "Nexus",
    "Comment": "Nexus Linux default look and feel",
