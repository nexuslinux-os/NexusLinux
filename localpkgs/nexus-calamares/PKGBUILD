    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/colors"
    install -m644 /dev/stdin "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/colors/BreezeDark.colors" <<'EOF'
