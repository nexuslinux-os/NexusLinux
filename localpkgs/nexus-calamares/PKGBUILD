[Effect-DesktopGrid]
enabled=true

[Effect-PresentWindows]
enabled=true

[Effect-Slide]
enabled=true

[Effect-SlideBack]
enabled=true

[Effect-WindowAperture]
enabled=true

[Plugins]
enabledPlugins=blur,desktopgrid,presentwindows,slide,slideback,windowaperture,kwin4_effect_slide,kwin4_effect_slideback,kwin4_effect_windowaperture
disabledPlugins=

[TabBox]
LayoutName=org.kde.breezedesk
