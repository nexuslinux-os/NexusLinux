# Maintainer: Nexus Linux <nexus@nexuslinux.org>
pkgname=nexus-calamares
pkgver=1.0
pkgrel=1
pkgdesc="Nexus Linux Calamares modules, branding, and configuration"
arch=(any)
url="https://github.com/nexuslinux-os/NexusLinux"
license=(GPL-3.0-or-later)
# No depends on calamares - it's built and installed separately as a package
source=(branding.desc
        write-os-release.sh
        shellprocess.conf
        netinstall.yaml
        settings_offline.conf
        kdeglobals
        kwinrc
        plasmarc
        plasma-org.kde.plasma.desktop-appletsrc
        metadata.json
        colors/BreezeDark.colors
        fonts/fonts.json
        icons/icons.json
        plasma/desktoptheme.json
        splash/Splash.qml
        look-and-feel/nexus/contents/fonts/fonts.json
        look-and-feel/nexus/contents/icons/icons.json
        look-and-feel/nexus/contents/plasma/desktoptheme.json
        look-and-feel/nexus/contents/splash/Splash.qml)
sha256sums=('SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP')

prepare() {
    # Ensure colors directory exists and BreezeDark.colors is available
    # $startdir is the directory containing the PKGBUILD (source directory)
    # $srcdir is the build directory where sources are extracted
    mkdir -p "$srcdir/colors"
    cp -f "$startdir/colors/BreezeDark.colors" "$srcdir/colors/BreezeDark.colors"
}

package() {
    # Calamares modules
    install -dm755 "$pkgdir/usr/share/nexus-calamares/modules"
    install -m644 netinstall.yaml "$pkgdir/usr/share/nexus-calamares/modules/netinstall.yaml"
    install -m644 settings_offline.conf "$pkgdir/usr/share/nexus-calamares/modules/settings_offline.conf"
    install -m644 shellprocess.conf "$pkgdir/usr/share/nexus-calamares/modules/shellprocess.conf"

    # Write OS release script
    install -m755 write-os-release.sh "$pkgdir/usr/share/nexus-calamares/write-os-release.sh"

    # Shellprocess config
    install -m644 shellprocess.conf "$pkgdir/usr/share/nexus-calamares/modules/shellprocess.conf"

    # Branding directory
    install -dm755 "$pkgdir/usr/share/nexus-calamares/branding/nexus"
    install -m644 branding.desc "$pkgdir/usr/share/nexus-calamares/branding/nexus/branding.desc"

    # Nexus skel configs for KDE Plasma
    install -dm755 "$pkgdir/usr/share/nexus-skel/.config"
    install -m644 kdeglobals "$pkgdir/usr/share/nexus-skel/.config/kdeglobals"
    install -m644 kwinrc "$pkgdir/usr/share/nexus-skel/.config/kwinrc"
    install -m644 plasmarc "$pkgdir/usr/share/nexus-skel/.config/plasmarc"
    install -m644 plasma-org.kde.plasma.desktop-appletsrc "$pkgdir/usr/share/nexus-skel/.config/plasma-org.kde.plasma.desktop-appletsrc"

    # Look-and-feel theme "Nexus" for lookandfeeltool
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents"
    install -m644 metadata.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/metadata.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/colors"
    install -m644 colors/BreezeDark.colors "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/colors/BreezeDark.colors"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/fonts"
    install -m644 fonts/fonts.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/fonts/fonts.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/icons"
    install -m644 icons/icons.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/icons/icons.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/plasma"
    install -m644 plasma/desktoptheme.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/plasma/desktoptheme.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/splash"
    install -m644 splash/Splash.qml "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/splash/Splash.qml"

    # Look-and-feel theme "Nexus" for lookandfeeltool (legacy path)
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents"
    install -m644 metadata.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/metadata.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/fonts"
    install -m644 fonts/fonts.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/fonts/fonts.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/icons"
    install -m644 icons/icons.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/icons/icons.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/plasma"
    install -m644 plasma/desktoptheme.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/plasma/desktoptheme.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/splash"
    install -m644 splash/Splash.qml "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/splash/Splash.qml"
}