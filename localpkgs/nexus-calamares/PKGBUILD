[Icons]
Theme=Breeze

[KCM]
InitCommands=

[ScreenSaver]
Default=org.kde.plasma.abstractwallpaper

[Session]
Default=plasma
EOF

    # kwinrc
    install -m644 /dev/stdin "$pkgdir/usr/share/nexus-skel/.config/kwinrc" <<'EOF'
[Compositing]
Enabled=true
GLPlatformInterface=auto
GLTextureFilter=1
GLCoreProfile=false
