{
    // System-wide fastfetch configuration for Nexus Linux.
    // Loaded by the fish greeting (nexus-fish-config) and any
    // interactive fastfetch run on a fresh install.
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/nexus-branding/fastfetch/logo.txt",
        "color": {
            "keys": "cyan",
            "separator": "gray"
        }
    },
    "display": {
        "separator": " | "
    }
}
